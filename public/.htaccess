# PR Marketing Ventures — static export headers (Hostinger LiteSpeed/Apache)

# ---------- Compression ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_headers.c>
  # Hashed build assets — safe to cache forever
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images / icons — a week, revalidate after
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  # HTML + sitemap/robots — always revalidate so deploys go live instantly
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---------- Security ----------
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # 'unsafe-inline' is required by Next.js bootstrap + JSON-LD scripts;
  # everything external is blocked (site is fully self-contained)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>

# ---------- Error pages ----------
ErrorDocument 404 /404.html

# ---------- Misc ----------
Options -Indexes
AddDefaultCharset utf-8

# Next.js exports the OG image without a file extension
<Files "opengraph-image">
  ForceType image/png
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</Files>
